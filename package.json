{
  "name": "sunny-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start:background": "node scripts/start-server.mjs",
    "models:export": "node scripts/blender-assets.mjs",
    "models:rebuild": "node scripts/blender-assets.mjs --rebuild",
    "world:export": "node scripts/blender-assets.mjs --world",
    "world:rebuild": "node scripts/blender-assets.mjs --world --rebuild",
    "resident:export": "node scripts/blender-assets.mjs --resident",
    "resident:rebuild": "node scripts/blender-assets.mjs --resident --rebuild",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pathfinding": "^0.4.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "robust-point-in-polygon": "^1.0.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.3"
  }
}
